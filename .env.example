# ======================================
# CONTROL PLANE — Configuração Central
# ======================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Azure Identity (seu tenant corporativo — fluxo de login da equipe interna)
AZURE_TENANT_ID=<seu-tenant-id-corporativo>
AZURE_CLIENT_ID=<app-registration-single-tenant>
AZURE_CLIENT_SECRET=<client-secret>

# Database (Control Plane — banco compartilhado, metadados apenas)
CP_DB_SERVER=ct-cp.database.windows.net
CP_DB_NAME=ct_control_plane
CP_DB_USER=ctadmin
CP_DB_PASSWORD=<senha-forte>

# Key Vault (para guardar segredos de integração, não dados de cliente)
KEYVAULT_URL=https://ct-cp-kv.vault.azure.net/

# Entra ID App Registration (multi-tenant — para onboarding de clientes)
# Esta é a app que os clientes vão autorizar no próprio tenant
CUSTOMER_APP_REGISTRATION_ID=<app-registration-multi-tenant>
CUSTOMER_APP_REGISTRATION_SECRET=<client-secret>

# Configurações de Execução
AZURE_SUBSCRIPTION_ID=<subscription-id>
RESOURCE_GROUP=ct-assessment-rg
ACR_LOGIN_SERVER=ctacr.azurecr.io

# Região padrão (Brasil Sul para residência LGPD)
DEFAULT_REGION=brazilsouth

# Billing e FinOps
FINOPS_COST_PER_GB=0.50
FINOPS_COST_PER_EXECUTION=5.00

# Segurança
JWT_SECRET=<jwt-secret-super-secret>
SESSION_SECRET=<session-secret>
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
APPINSIGHTS_CONNECTION_STRING=<connection-string>

# Email (SendGrid)
SENDGRID_API_KEY=<sendgrid-api-key>
SENDGRID_FROM_EMAIL=noreply@ctassessment.com.br
SENDGRID_REPLY_TO=support@ctassessment.com.br

# Azure Storage (para guardar PDFs)
AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>
