# ==============================================================================
# CT Assessment SaaS - Environment Configuration (PostgreSQL)
# ==============================================================================

# ==============================================================================
# Application
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ==============================================================================
# Database - Control Plane (PostgreSQL)
# ==============================================================================
# For Azure Database for PostgreSQL:
# CP_DB_SERVER=your-postgres-server.postgres.database.azure.com
# For local PostgreSQL:
# CP_DB_SERVER=localhost

CP_DB_SERVER=localhost
CP_DB_PORT=5432
CP_DB_NAME=ct_assessment_control_plane
CP_DB_USER=ct_user
CP_DB_PASSWORD=your_secure_password_here

# ==============================================================================
# Azure Identity / Azure AD
# ==============================================================================
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ==============================================================================
# Azure Key Vault
# ==============================================================================
KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# ==============================================================================
# Azure Storage (for PDF reports)
# ==============================================================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# ==============================================================================
# Azure Container Registry (ACR)
# ==============================================================================
ACR_LOGIN_SERVER=your-acr.azurecr.io
RESOURCE_GROUP=your-resource-group
DEFAULT_REGION=brazilsouth

# ==============================================================================
# Security
# ==============================================================================
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
SESSION_SECRET=your-session-secret-key-at-least-32-characters-long

# ==============================================================================
# CORS
# ==============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ==============================================================================
# SendGrid Email Integration
# ==============================================================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@ctassessment.com.br
SENDGRID_REPLY_TO=support@ctassessment.com.br

# ==============================================================================
# Logging
# ==============================================================================
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# ==============================================================================
# Azure Application Insights (Optional)
# ==============================================================================
# For monitoring and diagnostics
# APPINSIGHTS_INSTRUMENTATION_KEY=your-instrumentation-key

# ==============================================================================
# FinOps Configuration
# ==============================================================================
# Cost calculation parameters
FINOPS_COST_PER_GB=0.50
FINOPS_COST_PER_EXECUTION=5.00

# ==============================================================================
# Customer App Registration (for multi-tenant consent)
# ==============================================================================
CUSTOMER_APP_REGISTRATION_ID=your-app-id
CUSTOMER_APP_REGISTRATION_SECRET=your-app-secret

# ==============================================================================
# Microsoft Graph API
# ==============================================================================
# Scopes for Graph API access
GRAPH_SCOPES=Sites.Read.All,Files.Read.All,User.Read.All,AuditLog.Read.All

# ==============================================================================
# Notes on PostgreSQL Setup
# ==============================================================================
# 1. For Azure Database for PostgreSQL:
#    - Create a server in Azure portal
#    - Create firewall rules to allow your IP
#    - Enable SSL enforcement
#    - Use connection string format:
#      postgresql://user@server:password@server.postgres.database.azure.com:5432/dbname
#
# 2. For local development:
#    - Install PostgreSQL (https://www.postgresql.org/download/)
#    - Create database: createdb ct_assessment_control_plane
#    - Create user: createuser ct_user -P
#    - Grant privileges: ALTER ROLE ct_user CREATEDB;
#    - Test connection: psql -U ct_user -h localhost -d ct_assessment_control_plane
#
# 3. For tenant databases:
#    - Separate PostgreSQL database per tenant
#    - Connection string stored in control plane 'tenants.db_connection_string'
#    - Format: postgresql://user:password@host:port/db_name
#    - Database initialized automatically during tenant provisioning
#
# 4. TimescaleDB (Optional but Recommended):
#    - For time-series data compression
#    - Reduces storage 60-75% compared to standard PostgreSQL
#    - Install extension: CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;
#    - Apply to tenant databases for historical data tables

# ==============================================================================
# Running Migrations
# ==============================================================================
# Migrations run automatically on server startup
# To manually run: npm run migrate
# SQL files located in: ./migrations/*.sql
# Applied migrations tracked in: schema_migrations table
