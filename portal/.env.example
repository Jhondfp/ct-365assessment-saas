# ─── Banco do portal (control plane) — Azure SQL / SQL Server ───
# Local (docker compose up -d db): crie antes o banco: CREATE DATABASE ctassessment_portal
DATABASE_URL="sqlserver://localhost:1433;database=ctassessment_portal;user=sa;password=Troque-esta-senha1;encrypt=true;trustServerCertificate=true"

# ─── Auth.js ───
# Gere com: openssl rand -base64 33
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_URL="http://localhost:3000"

# ─── Login local (e-mail + senha) ───
AUTH_LOCAL_LOGIN="true"
# Administrador inicial (criado/garantido na inicialização; apague a senha depois do 1º acesso)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrador"

# ─── Login Microsoft 365 (Entra ID, multi-tenant) ───
# App registration "contas de qualquer diretório organizacional" · Redirect URI: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# Ativa quando ID e SECRET estão preenchidos. ISSUER vazio = https://login.microsoftonline.com/organizations/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Quem não foi cadastrado só entra se for destes domínios (fica aguardando perfil) ou estiver em ADMIN_EMAILS
INTERNAL_EMAIL_DOMAINS="cloudtarget.com.br"
ADMIN_EMAILS=""
# Apenas desenvolvimento: login só com e-mail, sem senha. Ignorado em produção.
AUTH_DEV_LOGIN="false"

# ─── Cofre das credenciais M365 dos clientes ───
# keyvault (produção): KEY_VAULT_URI + identidade gerenciada. local: tabela cifrada com SECRETS_KEY.
SECRET_STORE="local"
SECRETS_KEY="troque-por-uma-chave-longa"
KEY_VAULT_URI=""

# ─── Servidor dos bancos dos clientes (1 banco por cliente) ───
TENANT_SQL_SERVER="localhost"
TENANT_SQL_USER="sa"
TENANT_SQL_PASSWORD="Troque-esta-senha1"
TENANT_SQL_TRUST_CERT="true"
# Azure: nome do elastic pool onde os bancos novos são criados
TENANT_SQL_ELASTIC_POOL=""
TENANT_DB_PREFIX="ctassess_"
# Bancos existentes (modo EXTERNAL) em SQL Server com certificado autoassinado (on-premises/local)
EXTERNAL_SQL_TRUST_CERT="false"

# ─── Execução do coletor (job/) ───
# aca (Azure Container Apps Job) | docker (docker run local) | manual (o portal mostra o comando)
JOB_RUNNER="docker"
JOB_IMAGE="ctassessment-job:dev"
# URL do portal vista de dentro do container do job
PORTAL_CALLBACK_URL="http://host.docker.internal:3000"
# Assina os tokens das execuções (vazio = usa AUTH_SECRET)
JOB_SIGNING_SECRET=""
# Só com JOB_RUNNER=aca
ACA_SUBSCRIPTION_ID=""
ACA_RESOURCE_GROUP=""
ACA_JOB_NAME=""
