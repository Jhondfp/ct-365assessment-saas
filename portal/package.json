{
  "name": "ct-assessment-portal",
  "version": "0.1.0",
  "private": true,
  "description": "CT Assessment 365 — portal SaaS (clientes, conexões M365, execuções do coletor e dashboards)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
