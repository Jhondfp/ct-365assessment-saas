    "start:prod": "sh scripts/start.sh",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@azure/keyvault-secrets": "4.10.0",
    "@prisma/client": "6.19.3",
    "mssql": "11.0.1",
    "next": "15.5.15",
    "next-auth": "5.0.0-beta.29",
    "prisma": "6.19.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mssql": "9.1.7",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2"
  }
